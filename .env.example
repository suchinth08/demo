# AgentEye — environment variables
# Copy to .env for local overrides, or set these in the Railway service dashboard.
# Every value here is OPTIONAL: with none set, AgentEye runs exactly as it does
# today on localhost (serves the Hub + API in one process, spawns `claude -p`,
# stores data in ./.auth/agenteye.db, CORS '*').

# ── Server ──
PORT=7860
# Bind host. Default 127.0.0.1 (localhost-only). On Railway/containers the
# service must be reachable from outside → set HOST=0.0.0.0.
# HOST=0.0.0.0
# Allowed browser origin for the API. Leave unset ('*') for localhost.
# In the split deploy, set to your Vercel origin so the Railway API only
# answers the hosted frontend.
# CORS_ORIGIN=https://your-app.vercel.app
# Whether THIS process serves AgentEye_Hub.html. Default serves it (localhost).
# Set false on Railway, where Vercel hosts the static Hub and this is API-only.
# SERVE_STATIC=false

# ── LLM gateway (which backend answers the builder's turns) ──
# claude-cli (default) → spawns the local `claude -p`. Works on localhost only;
#   there is no Claude Code login inside a Railway container, so the hosted
#   deploy must pick one of the API providers below (wired in P2).
# openrouter → OpenRouter's OpenAI-compatible API with YOUR key (BYO-key).
# anthropic  → Anthropic API directly.
# LLM_PROVIDER=openrouter

# OpenRouter (when LLM_PROVIDER=openrouter) — get a key at openrouter.ai/keys.
# OPENROUTER_API_KEY=sk-or-...
# OpenRouter model ids are namespaced by vendor. These map the C1 task routes;
# pick any models your key can reach (Claude, GPT, Llama, etc.). Defaults shown.
# OPENROUTER_CHAT_MODEL=anthropic/claude-sonnet-4.6
# OPENROUTER_PREVIEW_MODEL=anthropic/claude-sonnet-4.6
# OPENROUTER_SUGGEST_MODEL=anthropic/claude-haiku-4.5
# OPENROUTER_GIST_MODEL=anthropic/claude-haiku-4.5
# Max output tokens per turn (default 8192). Without it OpenRouter reserves the
# model's full completion budget (~64K) and rejects on free-tier credit headroom.
# OPENROUTER_MAX_TOKENS=8192

# Anthropic API (when LLM_PROVIDER=anthropic).
# ANTHROPIC_API_KEY=sk-ant-...

# ── Model-per-task routing (C1 cost moderation; applies to claude-cli/anthropic) ──
# AGENTEYE_MODEL forces ONE model for every route; the per-route vars override
# individual tasks. Defaults: chat/preview=sonnet, suggest/gist=haiku.
# AGENTEYE_MODEL=
# AGENTEYE_CHAT_MODEL=claude-sonnet-4-6
# AGENTEYE_PREVIEW_MODEL=claude-sonnet-4-6
# AGENTEYE_SUGGEST_MODEL=claude-haiku-4-5
# AGENTEYE_GIST_MODEL=claude-haiku-4-5
# Per-turn timeout for the gateway call (ms).
# CLAUDE_TIMEOUT_MS=600000

# ── Database (P1) ──
# Set DATABASE_URL → AgentEye uses Postgres (workspace/db.pg.js). Unset → it uses the
# zero-config local SQLite default (workspace/db.sqlite.js). Same data-access surface.
# IMPORTANT: use the Supabase **pooler** string (Connect → Session mode, port 5432).
# The direct db.<ref>.supabase.co host is IPv6-only and unreachable on IPv4 networks/Railway.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres
# PG_POOL_MAX=8          # connection pool size (default 8)
# PG_SSL_STRICT=1        # verify the TLS chain (default off — Supabase cert may not chain locally)
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_SERVICE_KEY=...

# ── Auth (P3 — Supabase Auth; until then uses built-in scrypt/bearer) ──
# SUPABASE_JWT_SECRET=...         # to verify Supabase-issued JWTs server-side

# ── Storage (P4 — Supabase Storage for generated/ + library/; until then local fs) ──
# SUPABASE_STORAGE_BUCKET=agenteye-artifacts

# ── AWS (only for deploying the GENERATED client app's CFN/deploy bundle) ──
# These are the generated artifact's cloud, independent of where AgentEye is hosted.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
