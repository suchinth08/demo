# dependencies
node_modules/

# local env (committed template is .env.example)
.env
.env.local

# deploy tokens (Railway/Vercel) — never commit
.deploy.tokens.env

# generated solution repos (regenerable from a SolutionSpec via appgen)
generated/

# logs
*.log
.agenteye_server.log

# stray local memory (project memory lives under ~/.claude/projects/.../memory)
memory/

# private workspace data — accounts, sessions, per-user projects/drafts/conversations
.auth/
workspaces/

# vercel static deploy dir (generated)
agenteye-hub/
