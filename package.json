{
  "name": "agenteye-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Conversational Bedrock-agent provisioning UI bridged to local Claude Code",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "cfn:build": "node cfn/build.js",
    "cfn:backfill": "node cfn/build.js --all",
    "cfn:lint": "node cfn/lint.js",
    "cfn:deploy-bundle": "node cfn/deploy-manifest.js",
    "app:gen": "node appgen/generate.js",
    "solution:bundle": "node cfn/solution-deploy.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "js-yaml": "^4.2.0",
    "pg": "^8.21.0"
  }
}
